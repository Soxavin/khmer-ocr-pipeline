.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
dist/
*.egg-info/
.superpowers/
.impeccable/
.DS_Store

# Sensitive inputs — never commit
sample_data/
.streamlit/
# Dataset-factory corpus: PDFs stay local; only the README is tracked
corpus/*
!corpus/README.md
# HITL analyst corrections: cell crops + text from REAL financial documents —
# same sensitivity as corpus/, never commit
corrections/

# Generated benchmark / synthetic outputs
eval/datasets/
eval/runs/
eval/figures/
inspect_report.json
# recognizer-A/B output derived from real pages — never commit
predictions.json

# CRNN training-experiment run artifacts (checkpoints, metrics, plots)
research/khmer_crnn/runs/

# Promoted fine-tuned weights (large, regenerable via research/kiri_finetune/)
models/
# Fine-tuning artifacts (Tracks A/B): trainsets contain real-doc crops — never commit
research/kiri_finetune/trainset*/
research/kiri_finetune/run*/
research/kiri_finetune/*.log
research/layout_yolo/runs/
research/layout_yolo/*.pt
research/layout_yolo/data_local.yaml
# derived from real pages (recall_taxonomy output)
tools/eval/_recall_taxonomy_output.json

# Presentation materials — kept on disk, not tracked in the repo
docs/presentations/

# React frontend (apps/web)
apps/web/node_modules/
apps/web/dist/

# Secrets — API keys live in the environment or a local .env, never committed
.env
.env.*
!.env.example
*.gemini.json
.venv-challengers/

# uv package cache — never commit
.uv-cache/
