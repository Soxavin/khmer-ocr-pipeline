# Copy this file to `.env` (gitignored) and fill in your values.
# The pipeline auto-loads `.env` from the repo root (khmer_pipeline.local_env).
# A real shell export always overrides these — .env is only a fallback.

# Google AI Studio key for the Cloud (Gemini) engine. Get one (no credit card) at
# https://aistudio.google.com -> Get API key. See docs/ENGINE_EVALUATION.md §7.
GEMINI_API_KEY=

# Optional: pin the Gemini model (default: gemini-flash-latest).
# GEMINI_MODEL=gemini-3.6-flash
